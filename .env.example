# Insurance Pricing Engine - Environment Variables
# NVIDIA (Primary) + Gemini (Fallback) Configuration

# ============================================
# NVIDIA AI FOUNDATION API
# ============================================

# NVIDIA API Key (Primary Provider)
# Get from: https://build.nvidia.com/
# Sign up → Create API Key → Copy
NVIDIA_API_KEY=
NVIDIA_MODEL=

# ============================================
# GOOGLE GEMINI API (Fallback)
# ============================================

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Base URL (auto-set by Vercel in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# PRICING STRATEGY
# ============================================

# Default strategy: 'fallback' | 'validation' | 'consensus'
# fallback: NVIDIA → Gemini only if fails ($0.001/calc, fastest)
# validation: NVIDIA primary + Gemini validates ($0.002/calc, balanced)
# consensus: Both calculate + average ($0.003/calc, most accurate)
DEFAULT_PRICING_STRATEGY=fallback

# ============================================
# COST OPTIMIZATION
# ============================================

# Enable cost optimization (use cheaper models when appropriate)
ENABLE_COST_OPTIMIZATION=true

# Maximum tokens per request
MAX_TOKENS_PER_REQUEST=4000

# ============================================
# FEATURE FLAGS
# ============================================

# Enable dual-provider consensus (more expensive but more accurate)
ENABLE_DUAL_CONSENSUS=false

# Enable result caching for repeated calculations
ENABLE_RESULT_CACHING=true

# ============================================
# OPTIONAL: MONITORING & RATE LIMITING
# ============================================

# Upstash Redis for rate limiting (optional)
# UPSTASH_REDIS_REST_URL=...
# UPSTASH_REDIS_REST_TOKEN=...

# Sentry for error tracking (optional)
# SENTRY_DSN=...

# ============================================
# SECURITY
# ============================================

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

